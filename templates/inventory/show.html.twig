{% extends 'base.html.twig' %}

{% block title %}Détail de la Collection{% endblock %}

{% block body %}
    <h1>Collection : {{ inventory.description }}</h1>

    <h2>Caissons de basse dans cette collection :</h2>
    <ul>
        {% for subwoofer in inventory.subwoofers %}
            <li>
                <a href="{{ path('app_subwoofer_show', {'id': subwoofer.id}) }}">
                    <strong>{{ subwoofer.model }}</strong>
                </a> 
                de {{ subwoofer.brand }} 
                {% if subwoofer.year %} ({{ subwoofer.year }}) {% endif %}
            </li>
        {% else %}
            <li>Aucun caisson de basse pour le moment.</li>
        {% endfor %}
    </ul>

    <p><a href="{{ path('app_inventory_list') }}">Retour à la liste des collections</a></p>
{% endblock %}