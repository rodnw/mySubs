{% extends 'base.html.twig' %}

{% block custompage_script %}
    <script>

        /* Ici se trouve le code javascript nécessaire aux formulaires dynamiques des collections */

        document
            .querySelectorAll('.add_item_link')
            .forEach(btn => {
                btn.addEventListener("click", addFormToCollection)
            });

        document
            .querySelectorAll('ul.subwoofers li')
            .forEach((subwoofer) => {
                addSubwooferFormDeleteLink(subwoofer)
            })

        function addFormToCollection(e) {
            const collectionHolder = document.querySelector('.' + e.currentTarget.dataset.collectionHolderClass);

            const item = document.createElement('li');

            item.innerHTML = collectionHolder
                .dataset
                .prototype
                .replace(
                    /__name__/g,
                    collectionHolder.dataset.index
                );

            collectionHolder.appendChild(item);

            collectionHolder.dataset.index++;

            // add a delete link to the new form
            addSubwooferFormDeleteLink(item);
        };

        function addSubwooferFormDeleteLink(item) {
            const removeFormButton = document.createElement('button');
            removeFormButton.innerText = 'Supprimer ce caisson de basse';

            item.append(removeFormButton);

            removeFormButton.addEventListener('click', (e) => {
                e.preventDefault();
                // remove the li for the subwoofer form
                item.remove();
            });
        }

    </script>
{% endblock %} {# custompage_script #}
