<form method="post" action="{{ path('app_showcase_delete', {'id': showcase.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette vitrine ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ showcase.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
