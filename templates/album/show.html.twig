{% extends 'base.html.twig' %}

{% block title %}{{ album.title }}{% endblock %}

{% block main %}
    <h1>Détail de l'album</h1>
    
    <div class="form-horizontal mt-4">
        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label fw-bold">Titre</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">{{ album.title }}</div>
            </div>
        </div>
        
        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label fw-bold">Artiste</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">{{ album.artist }}</div>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label fw-bold">Année</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">
                    {# Utilisation de l'opérateur ternaire Twig vu dans le TP 5 #}
                    {{ album.annee ? album.annee : 'Année inconnue' }}
                </div>
            </div>
        </div>

        <div class="form-group row mb-4">
            <label class="col-sm-2 col-form-label fw-bold">Label</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">
                    {{ album.label ? album.label : 'Non renseigné' }}
                </div>
            </div>
        </div>
    </div>

    <a href="{{ path('app_inventory_show', { 'id': album.inventory.id }) }}" class="btn btn-secondary">
        Retour à la collection
    </a>
{% endblock %}