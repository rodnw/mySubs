{% extends 'base.html.twig' %}

{% block title %}{{ subwoofer.model }}{% endblock %}

{% block main %}
    <h1>Détail du caisson de basse</h1>

    <div class="form-horizontal mt-4">
        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label fw-bold">Modèle</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">{{ subwoofer.model }}</div>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label fw-bold">Marque</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">{{ subwoofer.brand }}</div>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label fw-bold">Année</label>
            <div class="col-sm-10">
                <div class="form-control form-control-plaintext">
                    {# Utilisation de l'opérateur ternaire Twig vu dans le TP 5 #}
                    {{ subwoofer.year ? subwoofer.year : 'Année inconnue' }}
                </div>
            </div>
        </div>

        {% if subwoofer.inventory %}
            <div class="form-group row mb-2">
                <label class="col-sm-2 col-form-label fw-bold">Collection</label>
                <div class="col-sm-10">
                    <div class="form-control form-control-plaintext">
                        <a href="{{ path('app_inventory_show', {'id': subwoofer.inventory.id}) }}">{{ subwoofer.inventory }}</a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_inventory_show', { 'id': subwoofer.inventory.id }) }}" class="btn btn-secondary">
            Retour à la collection
        </a>
        <a href="{{ path('app_subwoofer_edit', { 'id': subwoofer.id }) }}" class="btn btn-primary">
            Modifier
        </a>
        {{ include('subwoofer/_delete_form.html.twig') }}
    </div>
{% endblock %}
