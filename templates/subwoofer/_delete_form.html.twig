<form method="post" action="{{ path('app_subwoofer_delete', {'id': subwoofer.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce caisson de basse ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ subwoofer.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
